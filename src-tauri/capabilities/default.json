  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main and settings windows",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "window-state:default"
  ]
}
